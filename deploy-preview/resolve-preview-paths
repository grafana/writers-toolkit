#!/usr/bin/env bash

# Resolve preview path inputs for deploy-preview.
#
# Maps the PR base ref to a documentation target and substitutes any trailing
# "/next" or "/latest" segment in each source's website_directory and
# relative_prefix:
#
#   main           -> next
#   anything else  -> latest
#
# --schema emits only mounts from the PR checkout, with physical source paths.

set -euf -o pipefail

if [[ -n "${RUNNER_DEBUG+x}" ]]; then
  set -x
fi

readonly GITHUB_OUTPUT="${GITHUB_OUTPUT:-/dev/stdout}"
readonly BASE_SOURCES="${BASE_SOURCES:-}"
readonly TARGET_REF_NAME="${TARGET_REF_NAME:-}"

if [[ "${TARGET_REF_NAME}" == "main" ]]; then
  target="next"
else
  target="latest"
fi

sources="${BASE_SOURCES}"

if [[ -n "${sources}" ]]; then
  sources="$(jq -c --arg target "${target}" 'map(
    if (((.website_directory // "") | sub("/$"; "")) | test("(^|/)(next|latest)$")) then
      .website_directory |= ((. // "") | sub("/$"; "") | sub("/(next|latest)$"; "/" + $target))
      | .relative_prefix |= if . == null or . == "" then . else ((. | sub("/$"; "") | sub("/(next|latest)$"; "/" + $target)) + "/") end
    else
      .
    end
  )' <<<"${sources}")"
fi

if [[ "${1:-}" == --schema ]]; then
  if [[ -n "${WEBSITE_DIRECTORY:-}" ]]; then
    sources="$(jq -cn --arg source "${SOURCE_DIRECTORY:-docs/sources}" --arg target "$WEBSITE_DIRECTORY" \
      '[{source_directory: $source, website_directory: $target}]')"
  else
    # Other repositories and pinned refs are built from separate checkouts.
    sources="$(jq -c --arg repo "$REPO" --arg branch "${BRANCH:-}" --arg sha "$SHA" \
      'map(select((.repo // $repo) == $repo and
        ((.ref // "") == "" or .ref == $branch or .ref == $sha)))' <<<"${sources:-[]}")"
  fi

  # Change collection needs physical directories to read the base front matter.
  # shellcheck source=deploy-preview/resolve-latest-source.sh
  source "$(dirname "${BASH_SOURCE[0]}")/resolve-latest-source.sh"
  while IFS= read -r source_dir; do
    resolved="$(resolve_latest_placeholder "$source_dir" "$GITHUB_WORKSPACE/source-files")"
    if [[ "$resolved" == *'<LATEST>'* ]]; then
      echo "Could not resolve schema source directory: $source_dir" >&2
      exit 1
    fi
    sources="$(jq -c --arg from "$source_dir" --arg to "$resolved" \
      '(.[] | select(.source_directory == $from) | .source_directory) = $to' <<<"$sources")"
  done < <(jq -r '[.[].source_directory | strings | select(split("/") | index("<LATEST>"))] | unique[]' <<<"$sources")
fi

echo "sources=${sources}" >> "${GITHUB_OUTPUT}"
